# 应用根地址，保留实际部署路径；此处是占位域名。
EASYCHECK_BASE_URL=https://example.invalid/qdgj/
EASYCHECK_USERNAME=example-user
EASYCHECK_PASSWORD='replace-with-password'
# 本机 CLI 会话文件路径；Docker Compose 固定使用容器内的 /data/session.json。
EASYCHECK_SESSION_FILE=session.json

# Docker Compose 定时配置：默认每 5 分钟检查当前签到窗口，无需填写批次 ID。
# 例如每天北京时间 08:00：EASYCHECK_CRON='0 8 * * *'
EASYCHECK_CRON='*/5 * * * *'
EASYCHECK_TIMEZONE=Asia/Shanghai

# cron 签到成功通知：默认关闭；Telegram 和飞书可单独启用，也可同时启用。
# Telegram 须同时填写 Bot Token 和 Chat ID（私聊、群组或频道）。
EASYCHECK_TG_BOT_TOKEN=''
EASYCHECK_TG_CHAT_ID=''
# 飞书群自定义机器人 Webhook；启用签名校验时填写 SECRET，否则留空。
EASYCHECK_FEISHU_WEBHOOK_URL=''
EASYCHECK_FEISHU_SECRET=''
# 每个通知请求的超时，不影响站点请求的 --timeout。
EASYCHECK_NOTIFY_TIMEOUT=10s
